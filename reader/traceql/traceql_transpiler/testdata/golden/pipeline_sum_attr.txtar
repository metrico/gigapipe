-- meta --
route: simple
-- query --
{.http.status_code=200} | sum(http.response_size) > 1000
-- sql-0 --
WITH index_search as ( SELECT trace_id as trace_id, span_id as span_id, any(duration) as duration, any(timestamp_ns) as timestamp_ns, anyIf(toFloat64OrNull(val), key == 'http.response_size') as agg_val FROM traces_attrs_gin as traces_idx WHERE (((date) >= ('2024-01-01')) and ((date) <= ('2024-01-01')) and ((traces_idx.timestamp_ns) >= (1704067200000000000)) and ((traces_idx.timestamp_ns) < (1704070800000000000))) and ((((key) == ('http.status_code')) and ((isNotNull(toFloat64OrNull(val))) == (1)) and ((toFloat64OrZero(val)) == (200.000000))) or ((key) == ('http.response_size'))) GROUP BY trace_id, span_id HAVING ((bitAnd(groupBitOr(bitShiftLeft(toUInt64(((key) == ('http.status_code')) and ((isNotNull(toFloat64OrNull(val))) == (1)) and ((toFloat64OrZero(val)) == (200.000000))),0)) as bsCond,1)) != (0)) ORDER BY timestamp_ns desc ),index_grouped as ( SELECT trace_id as trace_id, groupArray(100)(span_id) as span_id FROM index_search GROUP BY trace_id HAVING ((sumIf(agg_val, isNotNull(agg_val))) > (1000.000000)) ORDER BY max(index_search.timestamp_ns) desc  LIMIT 20),trace_ids as ( SELECT trace_id FROM index_grouped),trace_span_ids as ( SELECT trace_id, span_id FROM index_grouped array JOIN span_id ),traces_info as ( SELECT traces.trace_id as trace_id, min(traces.timestamp_ns) as _start_time_unix_nano, intDiv(max(traces.timestamp_ns + traces.duration_ns) - min(traces.timestamp_ns), 1000000) as _duration_ms, argMin(traces.service_name, traces.timestamp_ns) as _root_service_name, argMin(traces.name, traces.timestamp_ns) as _root_trace_name FROM traces as traces WHERE (traces.trace_id IN (trace_ids)) GROUP BY traces.trace_id) SELECT lower(hex(traces.trace_id)) as trace_id, arrayMap(x -> lower(hex(x)), groupArray(traces.span_id)) as span_id, groupArray(traces.duration_ns) as duration, groupArray(traces.timestamp_ns) as timestamp_ns, min(_start_time_unix_nano) as start_time_unix_nano, min(_duration_ms) as duration_ms, min(_root_service_name) as root_service_name, min(_root_trace_name) as root_trace_name FROM traces as traces any left JOIN traces_info ON (traces.trace_id) == (traces_info.trace_id) WHERE (traces.trace_id IN (trace_ids)) and ((traces.trace_id, traces.span_id) IN (trace_span_ids)) GROUP BY traces.trace_id ORDER BY start_time_unix_nano desc  LIMIT 20
