-- meta --
range: 15m
step: 1m
-- query --
resets(http_requests_total{job="api"}[5m])
-- sql-0 --
WITH fp as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (2,0)) and ((((key) == ('job')) and ((val) == ('api'))) or (((key) == ('__name__')) and ((val) == ('http_requests_total')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('job')) and ((val) == ('api')), 0) + bitShiftLeft(((key) == ('__name__')) and ((val) == ('http_requests_total')), 1))) == (3))),bv_grouped as ( SELECT fingerprint as fingerprint, intDiv(timestamp_ns, 60000000000) * 60000 as timestamp_ms, argMaxMerge(last) as val FROM metrics_15s WHERE ((timestamp_ns) >= (1705318200000000000)) and ((timestamp_ns) <= (1705320007000000000)) and (fingerprint IN (fp)) GROUP BY fingerprint, timestamp_ms),bv_lead as ( SELECT fingerprint as fingerprint, toInt64(timestamp_ms) as bucket_ms, val as val, leadInFrame(toInt64(timestamp_ms), 1, toInt64(timestamp_ms) + toInt64(600000)) OVER bv_lead_wnd as next_ms FROM bv_grouped WINDOW bv_lead_wnd AS (PARTITION BY fingerprint ORDER BY timestamp_ms asc   ROWS BETWEEN CURRENT ROW AND 1 FOLLOWING)),cnt_vals as ( SELECT fingerprint as fingerprint, arrayJoin(range(bucket_ms, least(bucket_ms + toInt64(600000), next_ms, toInt64(1705320007000)), toInt64(60000))) as timestamp_ms, val as val, toUInt8(timestamp_ms = bucket_ms) as source FROM bv_lead ORDER BY fingerprint asc , timestamp_ms asc ),cnt_prev as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, val as val, source as source, argMaxIf(val, timestamp_ms, source = 1) OVER cnt_prev_wnd as prev, countIf(source = 1) OVER cnt_prev_wnd as prev_cnt FROM cnt_vals WINDOW cnt_prev_wnd AS (PARTITION BY fingerprint ORDER BY timestamp_ms asc   RANGE BETWEEN 300000 PRECEDING AND 1 PRECEDING)),cnt_flags as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, source as source, (prev_cnt > 0) * (prev > val) * (source = 1) as flag FROM cnt_prev),cnt_flags_wnd as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, sumIf(flag, source = 1) OVER cnt_close_wnd as flags, argMinIf(flag, timestamp_ms, source = 1) OVER cnt_close_wnd as first_flag, sum(source) OVER cnt_close_wnd as close_cnt FROM cnt_flags WINDOW cnt_close_wnd AS (PARTITION BY fingerprint ORDER BY timestamp_ms asc   RANGE BETWEEN 299999 PRECEDING AND CURRENT ROW)),values as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, toFloat64(flags - first_flag) as val FROM cnt_flags_wnd WHERE ((close_cnt) > (0))) SELECT * FROM ( SELECT 1 as type, fingerprint as fingerprint, timestamp_ms as timestamp_ms, val as val, '' as labels FROM values) UNION ALL ( SELECT  DISTINCT 2 as type, fingerprint as fingerprint, 0 as timestamp_ms, toFloat64(0) as val, toJSONString(mapFromArrays(arrayMap(x -> x.1, arrayFilter(x -> x.1 != '__name__', JSONExtractKeysAndValues(labels, 'String')) as a), arrayMap(x -> x.2, a))) as labels FROM time_series WHERE ((date) >= ('2024-01-15')) and (fingerprint IN (fp)))
