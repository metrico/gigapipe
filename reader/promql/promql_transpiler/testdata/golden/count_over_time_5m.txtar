-- meta --
range: 15m
step: 1m
-- query --
count_over_time(http_requests_total{job="api"}[5m])
-- sql-0 --
WITH fp as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (2,0)) and ((((key) == ('job')) and ((val) == ('api'))) or (((key) == ('__name__')) and ((val) == ('http_requests_total')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('job')) and ((val) == ('api')), 0) + bitShiftLeft(((key) == ('__name__')) and ((val) == ('http_requests_total')), 1))) == (3))),bv_grouped as ( SELECT fingerprint as fingerprint, intDiv(timestamp_ns, 60000000000) * 60000 as timestamp_ms, toFloat64(countMerge(count)) as b_cnt FROM metrics_15s WHERE ((timestamp_ns) >= (1705318500000000000)) and ((timestamp_ns) <= (1705320007000000000)) and (fingerprint IN (fp)) GROUP BY fingerprint, timestamp_ms),bv_lead as ( SELECT fingerprint as fingerprint, toInt64(timestamp_ms) as bucket_ms, b_cnt as b_cnt, leadInFrame(toInt64(timestamp_ms), 1, toInt64(timestamp_ms) + toInt64(300000)) OVER bv_lead_wnd as next_ms FROM bv_grouped WINDOW bv_lead_wnd AS (PARTITION BY fingerprint ORDER BY timestamp_ms asc   ROWS BETWEEN CURRENT ROW AND 1 FOLLOWING)),ot_vals as ( SELECT fingerprint as fingerprint, arrayJoin(range(bucket_ms, least(bucket_ms + toInt64(300000), next_ms, toInt64(1705320007000)), toInt64(60000))) as timestamp_ms, b_cnt as b_cnt, toUInt8(timestamp_ms = bucket_ms) as source FROM bv_lead ORDER BY fingerprint asc , timestamp_ms asc ),ot_wnd as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, sumIf(b_cnt, source = 1) OVER ot_frame as w_cnt, sum(source) OVER ot_frame as w_src FROM ot_vals WINDOW ot_frame AS (PARTITION BY fingerprint ORDER BY timestamp_ms asc   RANGE BETWEEN 299999 PRECEDING AND CURRENT ROW)),values as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, w_cnt as val FROM ot_wnd WHERE ((w_src) > (0))) SELECT * FROM ( SELECT 1 as type, fingerprint as fingerprint, timestamp_ms as timestamp_ms, val as val, '' as labels FROM values) UNION ALL ( SELECT  DISTINCT 2 as type, fingerprint as fingerprint, 0 as timestamp_ms, toFloat64(0) as val, toJSONString(mapFromArrays(arrayMap(x -> x.1, arrayFilter(x -> x.1 != '__name__', JSONExtractKeysAndValues(labels, 'String')) as a), arrayMap(x -> x.2, a))) as labels FROM time_series WHERE ((date) >= ('2024-01-15')) and (fingerprint IN (fp)))
