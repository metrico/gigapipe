-- meta --
range: 5s
route: raw
step: 1s
-- query --
up{job="api"}
-- sql-0 --
WITH fp as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (2,0)) and ((((key) == ('job')) and ((val) == ('api'))) or (((key) == ('__name__')) and ((val) == ('up')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('job')) and ((val) == ('api')), 0) + bitShiftLeft(((key) == ('__name__')) and ((val) == ('up')), 1))) == (3))),spls as ( SELECT samples.fingerprint as fingerprint, samples.value as val, intDiv(samples.timestamp_ns, 1000000) as timestamp_ms FROM samples_v3 as samples WHERE ((samples.timestamp_ns) > (1705319700000000000)) and ((samples.timestamp_ns) <= (1705320007000000000)) and (fingerprint IN (fp)) and (type IN (2,0)) ORDER BY fingerprint asc , timestamp_ns asc ),values as ( SELECT fingerprint, argMax(spls.val, spls.timestamp_ms) as val, intDiv(spls.timestamp_ms - 1705319700000 + 1000 - 1, 1000) * 1000 + 1705319700000 as timestamp_ms FROM spls GROUP BY timestamp_ms, fingerprint ORDER BY fingerprint asc , timestamp_ms asc ) SELECT * FROM (( SELECT 1 as type, fingerprint as fingerprint, timestamp_ms as timestamp_ms, val as val, '' as labels FROM values) UNION ALL ( SELECT  DISTINCT 2 as type, fingerprint as fingerprint, 0 as timestamp_ms, toFloat64(0) as val, labels as labels FROM time_series WHERE ((date) >= ('2024-01-15')) and (fingerprint IN (fp)))) ORDER BY type asc , fingerprint asc , timestamp_ms asc 
