-- meta --
range: 15m
step: 1m
-- query --
delta(cpu_temp_celsius{host="h1"}[5m])
-- sql-0 --
WITH fp as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (2,0)) and ((((key) == ('host')) and ((val) == ('h1'))) or (((key) == ('__name__')) and ((val) == ('cpu_temp_celsius')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('host')) and ((val) == ('h1')), 0) + bitShiftLeft(((key) == ('__name__')) and ((val) == ('cpu_temp_celsius')), 1))) == (3))),bv_grouped as ( SELECT fingerprint as fingerprint, intDiv(timestamp_ns, 60000000000) * 60000 as timestamp_ms, argMaxMerge(last) as val, intDiv(max(timestamp_ns), 1000000) as val_ts FROM metrics_15s WHERE ((timestamp_ns) >= (1705318200000000000)) and ((timestamp_ns) <= (1705320007000000000)) and (fingerprint IN (fp)) GROUP BY fingerprint, timestamp_ms),bv_lead as ( SELECT fingerprint as fingerprint, toInt64(timestamp_ms) as bucket_ms, val as val, val_ts as val_ts, leadInFrame(toInt64(timestamp_ms), 1, toInt64(timestamp_ms) + toInt64(600000)) OVER bv_lead_wnd as next_ms FROM bv_grouped WINDOW bv_lead_wnd AS (PARTITION BY fingerprint ORDER BY timestamp_ms asc   ROWS BETWEEN CURRENT ROW AND 1 FOLLOWING)),cnt_vals as ( SELECT fingerprint as fingerprint, arrayJoin(range(bucket_ms, least(bucket_ms + toInt64(600000), next_ms, toInt64(1705320007001)), toInt64(60000))) as timestamp_ms, val as val, val_ts as val_ts, toUInt8(timestamp_ms = bucket_ms) as source FROM bv_lead ORDER BY fingerprint asc , timestamp_ms asc ),cnt_prev as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, val as val, val_ts as val_ts, source as source, argMaxIf(val, timestamp_ms, source = 1) OVER cnt_prev_wnd as prev, countIf(source = 1) OVER cnt_prev_wnd as prev_cnt FROM cnt_vals WINDOW cnt_prev_wnd AS (PARTITION BY fingerprint ORDER BY timestamp_ms asc   RANGE BETWEEN 300000 PRECEDING AND 1 PRECEDING)),cnt_resets as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, val as val, val_ts as val_ts, source as source, 0 as reset FROM cnt_prev),cnt_ranges as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, argMinIf(val, timestamp_ms, source = 1) OVER cnt_close_wnd as first_v, argMinIf(val_ts, timestamp_ms, source = 1) OVER cnt_close_wnd as first_ts, argMaxIf(val, timestamp_ms, source = 1) OVER cnt_close_wnd as last_v, argMaxIf(val_ts, timestamp_ms, source = 1) OVER cnt_close_wnd as last_ts, sum(reset) OVER cnt_close_wnd as resets, argMinIf(reset, timestamp_ms, source = 1) OVER cnt_close_wnd as first_reset FROM cnt_resets WINDOW cnt_close_wnd AS (PARTITION BY fingerprint ORDER BY timestamp_ms asc   RANGE BETWEEN 299999 PRECEDING AND CURRENT ROW)),cnt_slope as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, first_ts as first_ts, last_ts as last_ts, first_v as first_v, last_v - first_v as c_change, (last_ts - first_ts) / 1000 as c_span_sec, (first_ts - (timestamp_ms - 300000)) / 1000 as c_back_edge, (timestamp_ms - last_ts) / 1000 as c_fwd_edge, c_back_edge as c_back, (c_span_sec + c_back + c_fwd_edge) / c_span_sec as c_reach FROM cnt_ranges),values as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, c_change * c_reach as val FROM cnt_slope WHERE ((last_ts) > (first_ts))) SELECT * FROM (( SELECT 1 as type, fingerprint as fingerprint, timestamp_ms as timestamp_ms, val as val, '' as labels FROM values) UNION ALL ( SELECT  DISTINCT 2 as type, fingerprint as fingerprint, 0 as timestamp_ms, toFloat64(0) as val, toJSONString(mapFromArrays(arrayMap(x -> x.1, arrayFilter(x -> x.1 != '__name__', JSONExtractKeysAndValues(labels, 'String')) as a), arrayMap(x -> x.2, a))) as labels FROM time_series WHERE ((date) >= ('2024-01-15')) and (fingerprint IN (fp)))) ORDER BY type asc , fingerprint asc , timestamp_ms asc 
