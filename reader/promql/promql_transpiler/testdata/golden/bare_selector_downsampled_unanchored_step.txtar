-- meta --
range: 20m
route: downsampled
step: 45s
-- query --
node_cpu_seconds_total{mode="idle"}
-- sql-0 --
WITH fp as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (2,0)) and ((((key) == ('mode')) and ((val) == ('idle'))) or (((key) == ('__name__')) and ((val) == ('node_cpu_seconds_total')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('mode')) and ((val) == ('idle')), 0) + bitShiftLeft(((key) == ('__name__')) and ((val) == ('node_cpu_seconds_total')), 1))) == (3))),values as ( SELECT samples.fingerprint as fingerprint, argMaxMerge(samples.last) as val, intDiv(samples.timestamp_ns, 45000 * 1000000) * 45000 as timestamp_ms FROM metrics_15s as samples WHERE ((samples.timestamp_ns) > (1705318500000000000)) and ((samples.timestamp_ns) <= (1705320007000000000)) and (fingerprint IN (fp)) and (type IN (2,0)) GROUP BY fingerprint, timestamp_ms ORDER BY fingerprint asc , timestamp_ms asc ) SELECT * FROM (( SELECT 1 as type, fingerprint as fingerprint, timestamp_ms as timestamp_ms, val as val, '' as labels FROM values) UNION ALL ( SELECT  DISTINCT 2 as type, fingerprint as fingerprint, 0 as timestamp_ms, toFloat64(0) as val, labels as labels FROM time_series WHERE ((date) >= ('2024-01-15')) and (fingerprint IN (fp)))) ORDER BY type asc , fingerprint asc , timestamp_ms asc 
