-- meta --
range: 15m
step: 1m
-- query --
max by (host, region) (cpu_usage{host="h1",region="us"})
-- sql-0 --
WITH labels_req as ( SELECT fingerprint as old_fingerprint, labels as old_labels, toJSONString(mapFromArrays(arrayMap(x -> x.1,arrayFilter(x -> x.1 IN ('host','region'), JSONExtractKeysAndValues(labels, 'String')) as a), arrayMap(x -> x.2, a))) as new_labels, cityHash64(new_labels) as new_fingerprint FROM time_series WHERE ((date) >= ('2024-01-15')) and (fingerprint IN (fp))),fp as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (2,0)) and ((((key) == ('host')) and ((val) == ('h1'))) or (((key) == ('region')) and ((val) == ('us'))) or (((key) == ('__name__')) and ((val) == ('cpu_usage')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('host')) and ((val) == ('h1')), 0) + bitShiftLeft(((key) == ('region')) and ((val) == ('us')), 1) + bitShiftLeft(((key) == ('__name__')) and ((val) == ('cpu_usage')), 2))) == (7))),bv_grouped as ( SELECT fingerprint as fingerprint, intDiv(timestamp_ns, 60000000000) * 60000 as timestamp_ms, argMaxMerge(last) as b_last, max(timestamp_ns) as b_ts FROM metrics_15s WHERE ((timestamp_ns) >= (1705318500000000000)) and ((timestamp_ns) <= (1705320007000000000)) and (fingerprint IN (fp)) GROUP BY fingerprint, timestamp_ms),bv_lead as ( SELECT fingerprint as fingerprint, toInt64(timestamp_ms) as bucket_ms, b_last as b_last, b_ts as b_ts, leadInFrame(toInt64(timestamp_ms), 1, toInt64(timestamp_ms) + toInt64(300000)) OVER bv_lead_wnd as next_ms FROM bv_grouped WINDOW bv_lead_wnd AS (PARTITION BY fingerprint ORDER BY timestamp_ms asc   ROWS BETWEEN CURRENT ROW AND 1 FOLLOWING)),ot_vals as ( SELECT fingerprint as fingerprint, arrayJoin(range(bucket_ms, least(bucket_ms + toInt64(300000), next_ms, toInt64(1705320007000)), toInt64(60000))) as timestamp_ms, b_last as b_last, b_ts as b_ts, toUInt8(timestamp_ms = bucket_ms) as source FROM bv_lead ORDER BY fingerprint asc , timestamp_ms asc ),ot_wnd as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, argMaxIf(b_last, b_ts, source = 1) OVER ot_frame as w_last, sum(source) OVER ot_frame as w_src FROM ot_vals WINDOW ot_frame AS (PARTITION BY fingerprint ORDER BY timestamp_ms asc   RANGE BETWEEN 299999 PRECEDING AND CURRENT ROW)),pre_agg as ( SELECT fingerprint as fingerprint, timestamp_ms as timestamp_ms, w_last as val FROM ot_wnd WHERE ((w_src) > (0))) SELECT * FROM ( SELECT 1 as type, labels_req.new_fingerprint as fingerprint, timestamp_ms as timestamp_ms, max(val) as val, '' as labels FROM pre_agg any left JOIN labels_req ON (pre_agg.fingerprint) == (labels_req.old_fingerprint) GROUP BY labels_req.new_fingerprint, timestamp_ms ORDER BY labels_req.new_fingerprint asc , timestamp_ms asc ) UNION ALL ( SELECT 2 as type, new_fingerprint as fingerprint, 0 as timestamp_ms, toFloat64(0) as val, new_labels as labels FROM labels_req)
