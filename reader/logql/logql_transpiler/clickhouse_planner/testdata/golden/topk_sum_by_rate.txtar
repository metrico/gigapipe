-- query --
topk(5, sum by (path) (rate({app="x"}[5m])))
-- sql-0 --
WITH fp_sel as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('x')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('x')), 0))) == (1))),pre_without_1 as ( SELECT intDiv(samples.timestamp_ns, 300000000000) * 300000000000 as timestamp_ns, fingerprint as fingerprint, '' as string, toFloat64(countMerge(count)) / 300.000000 as value FROM metrics_15s as samples WHERE ((samples.timestamp_ns) >= (1705316400000000000)) and ((samples.timestamp_ns) < (1705320000000000000)) and (type IN (1,0)) and (samples.fingerprint IN (fp_sel)) GROUP BY fingerprint, timestamp_ns),labels_2 as ( SELECT time_series.fingerprint as fingerprint, mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls))) as labels, cityHash64(arrayStringConcat(arrayMap((k,v)->concat(k,'=',v),mapKeys(mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls)))),mapValues(mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls))))),',')) as new_fingerprint FROM time_series as time_series PREWHERE ((time_series.date) >= ('2024-01-15')) and (type IN (1,0)) and (time_series.fingerprint IN (fp_sel)) WHERE (time_series.fingerprint IN ( SELECT fingerprint FROM pre_without_1))),lra_main as ( SELECT labels_2.new_fingerprint as fingerprint, pre_without_1.timestamp_ns as timestamp_ns, pre_without_1.value as value, '' as string, labels_2.labels as labels FROM pre_without_1 ANY LEFT  JOIN labels_2 ON (pre_without_1.fingerprint) == (labels_2.fingerprint)),par_a as ( SELECT fingerprint as fingerprint, sum(lra_main.value) as value, lra_main.timestamp_ns as timestamp_ns, '' as string, any(lra_main.labels) as labels FROM lra_main GROUP BY fingerprint, timestamp_ns),par_b as ( SELECT par_a.timestamp_ns as timestamp_ns, arraySlice(arraySort(x -> (-x.1, x.2, x.3),groupArray((par_a.value, par_a.fingerprint, par_a.labels))), 1, 5) as slice FROM par_a GROUP BY timestamp_ns) SELECT arr_b.2 as fingerprint, par_b.timestamp_ns as timestamp_ns, arr_b.1 as value, '' as string, arr_b.3 as labels FROM par_b array JOIN par_b.slice as arr_b 
