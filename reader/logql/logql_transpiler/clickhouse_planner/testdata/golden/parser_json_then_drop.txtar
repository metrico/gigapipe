-- query --
{app="x"} | json | drop a, b
-- sql-0 --
WITH fp_sel as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('x')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('x')), 0))) == (1))),main as ( SELECT samples.timestamp_ns as timestamp_ns, samples.fingerprint as fingerprint, samples.string as string, toFloat64(0) as value FROM samples_v3 as samples PREWHERE ((samples.timestamp_ns) >= (1705316407000000000)) and ((samples.timestamp_ns) < (1705320007000000000)) and (type IN (1,0)) WHERE (samples.fingerprint IN (fp_sel)) ORDER BY timestamp_ns desc ),_time_series as ( SELECT time_series.fingerprint as fingerprint, mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls)) as labels FROM time_series as time_series PREWHERE ((time_series.date) >= ('2024-01-15')) and (type IN (1,0)) and (time_series.fingerprint IN (fp_sel)) WHERE (time_series.fingerprint IN ( SELECT fingerprint FROM main))),subsel_1 as ( SELECT cityHash64(arraySort(arrayZip(mapKeys(labels),mapValues(labels)))) as fingerprint, main.timestamp_ns as timestamp_ns, mapUpdate(_time_series.labels, if(JSONType(string) = 'Object', mapFromArrays([], []), map('__error__', 'JSONParserErr', '__error_details__', 'line is not a valid json object'))) as labels, main.string as string, main.value as value FROM main ANY LEFT  JOIN _time_series ON (main.fingerprint) == (_time_series.fingerprint)) SELECT samples.timestamp_ns as timestamp_ns, samples.fingerprint as fingerprint, mapFilter((k,v) -> k!='a' and k!='b', samples.labels) as labels, samples.string as string, samples.value as value FROM subsel_1 as samples ORDER BY timestamp_ns desc  LIMIT 1000
