-- query --
{k8s_object_kind="Node"} | keep k8s_object_kind
-- sql-0 --
WITH fp_sel as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('k8s_object_kind')) and ((val) == ('Node')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('k8s_object_kind')) and ((val) == ('Node')), 0))) == (1))),main as ( SELECT samples.timestamp_ns as timestamp_ns, samples.fingerprint as fingerprint, samples.string as string, toFloat64(0) as value FROM samples_v3 as samples PREWHERE ((samples.timestamp_ns) >= (1705316407000000000)) and ((samples.timestamp_ns) < (1705320007000000000)) and (type IN (1,0)) WHERE (samples.fingerprint IN (fp_sel)) ORDER BY timestamp_ns desc ),_time_series as ( SELECT time_series.fingerprint as fingerprint, mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls)) as labels FROM time_series as time_series PREWHERE ((time_series.date) >= ('2024-01-15')) and (type IN (1,0)) and (time_series.fingerprint IN (fp_sel)) WHERE (time_series.fingerprint IN ( SELECT fingerprint FROM main))) SELECT main.fingerprint as fingerprint, main.timestamp_ns as timestamp_ns, mapFilter((k,v) -> k=='__error__' or k=='__error_details__' or k=='k8s_object_kind', _time_series.labels) as labels, main.string as string, main.value as value FROM main ANY LEFT  JOIN _time_series ON (main.fingerprint) == (_time_series.fingerprint) ORDER BY timestamp_ns desc  LIMIT 1000
