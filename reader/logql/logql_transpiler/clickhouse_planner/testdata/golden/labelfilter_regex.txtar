-- query --
{app="x"} | level =~ "warn|error"
-- sql-0 --
WITH subsel_1 as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('x')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('x')), 0))) == (1))),fp_sel as ( SELECT fingerprint FROM time_series WHERE (fingerprint IN (subsel_1)) and ((match(JSONExtractString(labels, 'level'), 'warn|error')) == (1))),main as ( SELECT samples.timestamp_ns as timestamp_ns, samples.fingerprint as fingerprint, samples.string as string, toFloat64(0) as value FROM samples_v3 as samples PREWHERE ((samples.timestamp_ns) >= (1705316407000000000)) and ((samples.timestamp_ns) < (1705320007000000000)) and (type IN (1,0)) WHERE (samples.fingerprint IN (fp_sel)) ORDER BY timestamp_ns desc  LIMIT 1000),_time_series as ( SELECT time_series.fingerprint as fingerprint, mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls)) as labels FROM time_series as time_series PREWHERE ((time_series.date) >= ('2024-01-15')) and (type IN (1,0)) and (time_series.fingerprint IN (fp_sel)) WHERE (time_series.fingerprint IN ( SELECT fingerprint FROM main))) SELECT main.fingerprint as fingerprint, main.timestamp_ns as timestamp_ns, _time_series.labels as labels, main.string as string, main.value as value FROM main ANY LEFT  JOIN _time_series ON (main.fingerprint) == (_time_series.fingerprint)
