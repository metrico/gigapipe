-- query --
avg(bytes_rate({app="x"}[5m])) by (path)
-- sql-0 --
WITH fp_sel as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('x')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('x')), 0))) == (1))),agg_a as ( SELECT samples.timestamp_ns as timestamp_ns, samples.fingerprint as fingerprint, samples.string as _string, toFloat64(0) as value FROM samples_v3 as samples PREWHERE ((samples.timestamp_ns) >= (1705316407000000000)) and ((samples.timestamp_ns) < (1705320007000000000)) and (type IN (1,0)) WHERE (samples.fingerprint IN (fp_sel))),pre_without_1 as ( SELECT intDiv(time_series.timestamp_ns, 300000000000) * 300000000000 as timestamp_ns, fingerprint as fingerprint, '' as string, toFloat64(sum(length(_string))) / 300.000000 as value FROM agg_a as time_series GROUP BY fingerprint, timestamp_ns),labels_2 as ( SELECT time_series.fingerprint as fingerprint, mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls))) as labels, cityHash64(arrayStringConcat(arrayMap((k,v)->concat(k,'=',v),mapKeys(mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls)))),mapValues(mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls))))),',')) as new_fingerprint FROM time_series as time_series PREWHERE ((time_series.date) >= ('2024-01-15')) and (type IN (1,0)) and (time_series.fingerprint IN (fp_sel)) WHERE (time_series.fingerprint IN ( SELECT fingerprint FROM pre_without_1))),lra_main as ( SELECT labels_2.new_fingerprint as fingerprint, pre_without_1.timestamp_ns as timestamp_ns, pre_without_1.value as value, '' as string, labels_2.labels as labels FROM pre_without_1 ANY LEFT  JOIN labels_2 ON (pre_without_1.fingerprint) == (labels_2.fingerprint)) SELECT fingerprint as fingerprint, avg(lra_main.value) as value, lra_main.timestamp_ns as timestamp_ns, '' as string, any(lra_main.labels) as labels FROM lra_main GROUP BY fingerprint, timestamp_ns
