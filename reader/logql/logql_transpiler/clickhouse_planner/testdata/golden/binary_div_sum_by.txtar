-- query --
sum by (path) (rate({app="a"}[1m])) / sum by (path) (rate({app="b"}[1m]))
-- sql-0 --
 SELECT fingerprint, anyIf(labels, side = 1) as labels, argMinIf(value, timestamp_ns, side = 1) / argMinIf(value, timestamp_ns, side = 2) as value, timestamp_ns FROM ( SELECT fingerprint as fingerprint, sum(lra_main.value) as value, lra_main.timestamp_ns as timestamp_ns, '' as string, any(lra_main.labels) as labels, 1 as side FROM ( SELECT labels_2.new_fingerprint as fingerprint, pre_without_1.timestamp_ns as timestamp_ns, pre_without_1.value as value, '' as string, labels_2.labels as labels FROM ( SELECT intDiv(samples.timestamp_ns, 60000000000) * 60000000000 as timestamp_ns, fingerprint as fingerprint, '' as string, toFloat64(countMerge(count)) / 60.000000 as value FROM metrics_15s as samples WHERE ((samples.timestamp_ns) >= (1705316400000000000)) and ((samples.timestamp_ns) < (1705320000000000000)) and (type IN (1,0)) and (samples.fingerprint IN (( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('a')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('a')), 0))) == (1))) as fp_sel)) GROUP BY fingerprint, timestamp_ns) as pre_without_1 ANY LEFT  JOIN ( SELECT time_series.fingerprint as fingerprint, mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls))) as labels, cityHash64(arrayStringConcat(arrayMap((k,v)->concat(k,'=',v),mapKeys(mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls)))),mapValues(mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls))))),',')) as new_fingerprint FROM time_series as time_series PREWHERE ((time_series.date) >= ('2024-01-15')) and (type IN (1,0)) and (time_series.fingerprint IN (( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('a')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('a')), 0))) == (1))) as fp_sel)) WHERE (time_series.fingerprint IN ( SELECT fingerprint FROM ( SELECT intDiv(samples.timestamp_ns, 60000000000) * 60000000000 as timestamp_ns, fingerprint as fingerprint, '' as string, toFloat64(countMerge(count)) / 60.000000 as value FROM metrics_15s as samples WHERE ((samples.timestamp_ns) >= (1705316400000000000)) and ((samples.timestamp_ns) < (1705320000000000000)) and (type IN (1,0)) and (samples.fingerprint IN (( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('a')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('a')), 0))) == (1))) as fp_sel)) GROUP BY fingerprint, timestamp_ns) as pre_without_1))) as labels_2 ON (pre_without_1.fingerprint) == (labels_2.fingerprint)) as lra_main GROUP BY fingerprint, timestamp_ns UNION ALL  SELECT fingerprint as fingerprint, sum(lra_main.value) as value, lra_main.timestamp_ns as timestamp_ns, '' as string, any(lra_main.labels) as labels, 2 as side FROM ( SELECT labels_4.new_fingerprint as fingerprint, pre_without_3.timestamp_ns as timestamp_ns, pre_without_3.value as value, '' as string, labels_4.labels as labels FROM ( SELECT intDiv(samples.timestamp_ns, 60000000000) * 60000000000 as timestamp_ns, fingerprint as fingerprint, '' as string, toFloat64(countMerge(count)) / 60.000000 as value FROM metrics_15s as samples WHERE ((samples.timestamp_ns) >= (1705316400000000000)) and ((samples.timestamp_ns) < (1705320000000000000)) and (type IN (1,0)) and (samples.fingerprint IN (( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('b')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('b')), 0))) == (1))) as fp_sel)) GROUP BY fingerprint, timestamp_ns) as pre_without_3 ANY LEFT  JOIN ( SELECT time_series.fingerprint as fingerprint, mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls))) as labels, cityHash64(arrayStringConcat(arrayMap((k,v)->concat(k,'=',v),mapKeys(mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls)))),mapValues(mapFilter((k,v) -> k IN ('path'), mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls))))),',')) as new_fingerprint FROM time_series as time_series PREWHERE ((time_series.date) >= ('2024-01-15')) and (type IN (1,0)) and (time_series.fingerprint IN (( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('b')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('b')), 0))) == (1))) as fp_sel)) WHERE (time_series.fingerprint IN ( SELECT fingerprint FROM ( SELECT intDiv(samples.timestamp_ns, 60000000000) * 60000000000 as timestamp_ns, fingerprint as fingerprint, '' as string, toFloat64(countMerge(count)) / 60.000000 as value FROM metrics_15s as samples WHERE ((samples.timestamp_ns) >= (1705316400000000000)) and ((samples.timestamp_ns) < (1705320000000000000)) and (type IN (1,0)) and (samples.fingerprint IN (( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('b')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('b')), 0))) == (1))) as fp_sel)) GROUP BY fingerprint, timestamp_ns) as pre_without_3))) as labels_4 ON (pre_without_3.fingerprint) == (labels_