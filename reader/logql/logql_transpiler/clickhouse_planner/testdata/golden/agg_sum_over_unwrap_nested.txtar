-- query --
sum(sum_over_time({app="x"} | json | unwrap bytes [10s]) by (path)) by (path)
-- sql-0 --
WITH fp_sel as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('x')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('x')), 0))) == (1))),main as ( SELECT samples.timestamp_ns as timestamp_ns, samples.fingerprint as fingerprint, samples.string as string, toFloat64(0) as value FROM samples_v3 as samples PREWHERE ((samples.timestamp_ns) >= (1705316407000000000)) and ((samples.timestamp_ns) < (1705320007000000000)) and (type IN (1,0)) WHERE (samples.fingerprint IN (fp_sel)) ORDER BY timestamp_ns desc ),_time_series as ( SELECT time_series.fingerprint as fingerprint, mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls)) as labels FROM time_series as time_series PREWHERE ((time_series.date) >= ('2024-01-15')) and (type IN (1,0)) and (time_series.fingerprint IN (fp_sel)) WHERE (time_series.fingerprint IN ( SELECT fingerprint FROM main))),subsel_1 as ( SELECT cityHash64(arraySort(arrayZip(mapKeys(labels),mapValues(labels)))) as fingerprint, main.timestamp_ns as timestamp_ns, mapUpdate(_time_series.labels, if(JSONType(string) = 'Object', mapFromArrays([], []), map('__error__', 'JSONParserErr', '__error_details__', 'line is not a valid json object'))) as labels, main.string as string, main.value as value FROM main ANY LEFT  JOIN _time_series ON (main.fingerprint) == (_time_series.fingerprint)),pre_by_without_2 as ( SELECT samples.timestamp_ns as timestamp_ns, samples.fingerprint as fingerprint, samples.labels as labels, samples.string as string, toFloat64OrNull(samples.labels['bytes']) as value FROM subsel_1 as samples WHERE (value IS NOT NULL)),unwrap_1 as ( SELECT timestamp_ns as timestamp_ns, cityHash64(arrayStringConcat(arrayMap((k,v)->concat(k,'=',v),mapKeys(mapFilter((k,v) -> k IN ('path'), pre_by_without_2.labels)),mapValues(mapFilter((k,v) -> k IN ('path'), pre_by_without_2.labels))),',')) as fingerprint, mapFilter((k,v) -> k IN ('path'), pre_by_without_2.labels) as labels, string as string, value as value FROM pre_by_without_2),pre_by_without_3 as ( SELECT intDiv(timestamp_ns, 10000000000) * 10000000000 as timestamp_ns, fingerprint, '' as string, sum(unwrap_1.value) as value, any(labels) as labels FROM unwrap_1 GROUP BY fingerprint, timestamp_ns),lra_main as ( SELECT timestamp_ns as timestamp_ns, cityHash64(arrayStringConcat(arrayMap((k,v)->concat(k,'=',v),mapKeys(mapFilter((k,v) -> k IN ('path'), pre_by_without_3.labels)),mapValues(mapFilter((k,v) -> k IN ('path'), pre_by_without_3.labels))),',')) as fingerprint, mapFilter((k,v) -> k IN ('path'), pre_by_without_3.labels) as labels, string as string, value as value FROM pre_by_without_3) SELECT fingerprint as fingerprint, sum(lra_main.value) as value, lra_main.timestamp_ns as timestamp_ns, '' as string, any(lra_main.labels) as labels FROM lra_main GROUP BY fingerprint, timestamp_ns
