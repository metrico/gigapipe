-- query --
rate({app="x"}[5m])
-- sql-0 --
WITH fp_sel as ( SELECT fingerprint FROM time_series_gin WHERE ((date) >= ('2024-01-15')) and (type IN (1,0)) and ((((key) == ('app')) and ((val) == ('x')))) GROUP BY fingerprint HAVING ((groupBitOr(bitShiftLeft(((key) == ('app')) and ((val) == ('x')), 0))) == (1))),main as ( SELECT intDiv(samples.timestamp_ns, 300000000000) * 300000000000 as timestamp_ns, fingerprint as fingerprint, '' as string, toFloat64(countMerge(count)) / 300.000000 as value FROM metrics_15s as samples WHERE ((samples.timestamp_ns) >= (1705316400000000000)) and ((samples.timestamp_ns) < (1705320000000000000)) and (type IN (1,0)) and (samples.fingerprint IN (fp_sel)) GROUP BY fingerprint, timestamp_ns),_time_series as ( SELECT time_series.fingerprint as fingerprint, mapFromArrays(arrayMap(x -> x.1, JSONExtractKeysAndValues(time_series.labels, 'String') as rawlbls), arrayMap(x -> x.2, rawlbls)) as labels FROM time_series as time_series PREWHERE ((time_series.date) >= ('2024-01-15')) and (type IN (1,0)) and (time_series.fingerprint IN (fp_sel)) WHERE (time_series.fingerprint IN ( SELECT fingerprint FROM main))) SELECT main.fingerprint as fingerprint, main.timestamp_ns as timestamp_ns, _time_series.labels as labels, main.string as string, main.value as value FROM main ANY LEFT  JOIN _time_series ON (main.fingerprint) == (_time_series.fingerprint)
